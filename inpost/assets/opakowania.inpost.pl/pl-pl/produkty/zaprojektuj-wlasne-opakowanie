  ;(() => {
    const bridgeAuthCookie = "wl_astro_auth_bridge"
    const bridgeCustomerCookie = "wl_astro_auth_ctx_bridge"
    const bridgeCustomerCookieLegacy = "wl_astro_customer_bridge"
    const authSessionChangedEvent = "wl:auth-session-updated"

    const readBridgeCookie = (name) => {
      try {
        const match = document.cookie
          .split(";")
          .map((part) => part.trim())
          .find((part) => part.startsWith(name + "="))

        if (!match) return null

        return decodeURIComponent(match.slice(name.length + 1))
      } catch {
        return null
      }
    }

    const clearBridgeCookie = (name) => {
      try {
        const secure =
          window.location.protocol === "https:" ? "; Secure" : ""
        document.cookie =
          name + "=; Path=/; Max-Age=0; SameSite=Lax" + secure
      } catch {
        // Ignore: the cookie will expire on its own.
      }
    }

    const bridgeToken = readBridgeCookie(bridgeAuthCookie)
    const bridgeCustomerId =
      readBridgeCookie(bridgeCustomerCookie) ??
      readBridgeCookie(bridgeCustomerCookieLegacy)

    if (!bridgeToken || !bridgeCustomerId) return

    let changed = false
    try {
      if (window.localStorage?.getItem("token") !== bridgeToken) {
        window.localStorage?.setItem("token", bridgeToken)
        changed = true
      }
      if (window.localStorage?.getItem("customer") !== bridgeCustomerId) {
        window.localStorage?.setItem("customer", bridgeCustomerId)
        changed = true
      }
    } catch {
      // Storage may be unavailable in private mode; SSR cookies still drive
      // the rendered state in that case.
    }

    clearBridgeCookie(bridgeAuthCookie)
    clearBridgeCookie(bridgeCustomerCookie)
    clearBridgeCookie(bridgeCustomerCookieLegacy)

    if (changed) {
      window.dispatchEvent(new Event(authSessionChangedEvent))
    }
