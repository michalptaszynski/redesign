oke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><div class="astro-header__categories-panel"><a href="/pl-pl/produkty/gabaryt-a" data-e2e-target="category-link" data-astro-prefetch="hover">Gabaryt A</a><a href="/pl-pl/produkty/gabaryt-b" data-e2e-target="category-link" data-astro-prefetch="hover">Gabaryt B</a><a href="/pl-pl/produkty/gabaryt-c" data-e2e-target="category-link" data-astro-prefetch="hover">Gabaryt C</a></div></details><a href="/pl-pl/produkty/nowosci" data-e2e-target="category-link" data-astro-prefetch="hover">Nowości</a><a href="/pl-pl/produkty/pakiety" data-e2e-target="category-link" data-astro-prefetch="hover">Pakiety</a><details class="astro-header__categories-menu" data-astro-header-categories><summary><span>Nadruk</span><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary><div class="astro-header__categories-panel"><a href="/pl-pl/produkty/personalizowane" data-e2e-target="category-link" data-astro-prefetch="hover">Personalizowane</a><a href="/pl-pl/produkty/bez-nadruku" data-e2e-target="category-link" data-astro-prefetch="hover">Bez nadruku</a><a href="/pl-pl/produkty/z-nadrukiem" data-e2e-target="category-link" data-astro-prefetch="hover">Z nadrukiem</a></div></details><a href="/pl-pl/produkty/zaprojektuj-wlasne-opakowanie" data-e2e-target="category-link" data-astro-prefetch="hover">Zaprojektuj własne opakowanie</a></div></div></nav></div><div data-astro-header-slot="limited-access-alert"></div><script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
  ;(() => {
    if (window.__wlAstroHeaderStateControllerReady) {
      return
    }

    window.__wlAstroHeaderStateControllerReady = true
    const adminPanelCustomerSessionKey = "wl:header-admin-panel-customer"
    const adminPanelEmptyClass = "astro-header__admin-panel-slot--empty"
    const adminPanelSlotSelector = '[data-astro-header-slot="admin-panel"]'
    const freeProductsEmptyClass =
      "astro-header__free-products-slot--empty"
    const freeProductsSlotSelector =
      '[data-astro-header-slot="free-products"]'
    const hasStoredSession = () => {
      try {
        return (
          !!window.localStorage?.getItem("customer") &&
          !!window.localStorage?.getItem("token")
        )
      } catch {
        return false
      }
    }

    const getStoredCustomerId = () => {
      try {
        return window.localStorage?.getItem("customer") ?? null
      } catch {
        return null
      }
    }

    const getCachedAdminPanelCustomerId = () => {
      try {
        return (
          window.sessionStorage?.getItem(adminPanelCustomerSessionKey) ?? null
        )
      } catch {
        return null
      }
    }

    const rememberAdminPanelCustomer = (customerId) => {
      if (!customerId) return

      try {
        window.sessionStorage?.setItem(
          adminPanelCustomerSessionKey,
          customerId
        )
      } catch {
        // Ignore storage failures; the hydrated controller will verify permissions.
      }
    }

    const forgetAdminPanelCustomer = () => {
      try {
        window.sessionStorage?.removeItem(adminPanelCustomerSessionKey)
      } catch {
        // Ignore storage failures; the hydrated controller will verify permissions.
      }
    }

    const ensureAdminPanelLink = (root, slot) => {
      const href = slot.dataset.adminPanelHref
      const label = slot.dataset.adminPanelLabel
      if (!href || !label) return

      const anchor =
        slot.querySelector("a") ||
        (root.createElement
          ? root.createElement("a")
          : document.createElement("a"))

      anchor.href = href
      anchor.textContent = label
      if (href.startsWith("/")) {
        anchor.setAttribute("data-astro-prefetch", "hover")
      }

      if (!anchor.parentElement) {
        slot.replaceChildren(anchor)
      }

      slot.classList.remove(adminPanelEmptyClass)
    }

    const applyAdminPanelState = (root = document) => {
      const slot = root.querySelector(adminPanelSlotSelector)
      if (!(slot instanceof HTMLElement)) return

      const customerId = getStoredCustomerId()
      if (!hasStoredSession() || !customerId) {
        forgetAdminPanelCustomer()
        slot.replaceChildren()
        slot.classList.add(adminPanelEmptyClass)
        return
      }

      if (slot.querySelector("a")) {
        rememberAdminPanelCustomer(customerId)
        slot.classList.remove(adminPanelEmptyClass)
        return
      }

      if (getCachedAdminPanelCustomerId() === customerId) {
        ensureAdminPanelLink(root, slot)
      }
    }

    const applyAccountState = (root, options) => {
      const hasSession = hasStoredSession()
      const allowDowngrade = !!(options && options.allowAccountDowngrade)

      // Trust the SSR-rendered state on the initial paint (and on Astro view
      // transitions). Safari may not have committed the bridge cookies or
      // localStorage by the time we run, so flipping the anchor based on a
      // missing local session would visibly log out a freshly authenticated
      // user. We only downgrade in response to explicit auth events
      // (logout dispatched by the SPA, cross-tab storage events).
      if (!hasSession && !allowDowngrade) {
        return
      }

      const state = hasSession ? "account" : "login"

      root
        .querySelectorAll("[data-astro-header-account-state]")
        .forEach((slot) => {
          if (!(slot instanceof HTMLElement)) return

          const anchor = slot.querySelector("a")
          if (!(anchor instanceof HTMLAnchorElement)) return

          const label = slot.dataset[`${state}Label`]
          const href = slot.dataset[`${state}Href`]
          const e2eTarget = slot.dataset[`${state}E2eTarget`]
          const labelNode = anchor.querySelector(
            "[data-astro-header-account-label]"
          )

          if (label) {
            if (labelNode) {
              labelNode.textContent = label
            } else {
              anchor.textContent = label
            }
          }
          if (href) anchor.href = href
          if (e2eTarget) {
            anchor.setAttribute("data-e2e-target", e2eTarget)
          }
        })
    }

    const getCachedFreeProductPromotions = (root, slot, customerId) => {
      const header = root.querySelector("[data-astro-header]")
      const channelCode = slot.dataset.freeProductsChannelCode
      const isEnabled = slot.dataset.freeProductsEnabled === "true"

      if (!(header instanceof HTMLElement) || !channelCode || !isEnabled) {
        return null
      }

      const keyPrefix = header.dataset.freeProductsCachePrefix

      if (!keyPrefix) {
        return null
      }

      try {
        const key = [
          keyPrefix,
          encodeURIComponent(channelCode),
          encodeURIComponent(customerId)
        ].join(":")
        const rawValue = window.sessionStorage?.getItem(key)

        if (!rawValue) {
          return null
        }

        const entry = JSON.parse(rawValue)
        const promotions = Array.isArray(entry?.promotions)
          ? entry.promotions
          : []
        const expiresAt =
          typeof entry?.expiresAt === "number" ? entry.expiresAt : 0

        if (expiresAt <= Date.now()) {
          window.sessionStorage?.removeItem(key)
          return null
        }

        return promotions.length > 0 ? promotions : null
      } catch {
        return null
      }
    }

    const applyFreeProductsState = (root = document) => {
      const slot = root.querySelector(freeProductsSlotSelector)
      if (!(slot instanceof HTMLElement)) return

      if (slot.dataset.freeProductsEnabled !== "true") {
        slot.classList.add(freeProductsEmptyClass)
        return
      }

      const customerId = getStoredCustomerId()
      if (!hasStoredSession() || !customerId) {
        slot.classList.add(freeProductsEmptyClass)
        return
      }

      if (!slot.classList.contains(freeProductsEmptyClass)) {
        return
      }

      if (getCachedFreeProductPromotions(root, slot, customerId)) {
        slot.classList.remove(freeProductsEmptyClass)
      }
    }

    const applyHeaderState = (root, options) => {
      applyAccountState(root || document, options)
      applyAdminPanelState(root || document)
      applyFreeProductsState(root || document)
    }

    const authChangedOptions = { allowAccountDowngrade: true }

    applyHeaderState()
    window.addEventListener("wl:auth-session-updated", () =>
      applyHeaderState(document, authChangedOptions)
    )
    window.addEventListener(
      document.querySelector("[data-astro-header]")?.dataset
        .freeProductsCacheEvent || "wl:free-product-promotions-updated",
      () => applyHeaderState()
    )
    window.addEventListener("storage", (event) => {
      if (event.key === "customer" || event.key === "token") {
        applyHeaderState(document, authChangedOptions)
      }
    })
    document.addEventListener("astro:before-swap", (event) => {
      const nextDocument = event.newDocument || document
      applyHeaderState(nextDocument)
    })
    document.addEventListener("astro:after-swap", () => applyHeaderState())
  })()
